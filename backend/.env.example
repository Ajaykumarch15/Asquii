# Copy to .env for local development. Never put real credentials in version control.
APP_NAME=Asquii API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Use the Supabase transaction pooler endpoint for short-lived application requests
# (typically port 6543). Keep the direct/session endpoint (typically port 5432)
# for reviewed migration operations. Supply credentials through local .env/secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=5
DATABASE_CONNECT_TIMEOUT=5
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=PLACEHOLDER
# Supabase asymmetric signing keys are verified from this project's JWKS endpoint.
# Issuer defaults to SUPABASE_URL/auth/v1; audience defaults to authenticated.
SUPABASE_JWT_SIGNING_METHOD=jwks
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override; must use the configured Supabase host and HTTPS.
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# For legacy projects only, explicitly select hs256 and provide a secret out of band.
# SUPABASE_JWT_SIGNING_METHOD=hs256
# SUPABASE_JWT_SECRET=SET_OUT_OF_BAND
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
