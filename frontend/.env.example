# Asquii frontend environment (Vite)
# Copy to .env and fill values. Never commit the real .env.

# Supabase project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://yovvhkzqlzhfkjwpumxz.supabase.co

# Publishable ("anon") key from Dashboard -> Project Settings -> API.
# Safe for browsers; never place a service-role key here.
VITE_SUPABASE_ANON_KEY=

# FastAPI backend base URL, with version prefix.
VITE_API_URL=http://127.0.0.1:8000/api/v1
